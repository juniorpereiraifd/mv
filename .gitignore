# Copia do build do Portal-B2B-main 2 em public/salao/ (servida em /salao) –
# artefato de build, regenerável, não versionado. Regenerar quando necessário:
#   cd "Portal-B2B-main 2" && pnpm install && pnpm exec vite build --base /salao/
#   rsync -a dist/ ../public/salao/
/public/salao/

